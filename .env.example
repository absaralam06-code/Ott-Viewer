# Password for the single shared account. Required — the app refuses to start without it.
APP_PASSWORD=change-me

# Secrets for the session cookie and for signing proxy URLs.
# Generate each with:  openssl rand -hex 32
SESSION_SECRET=
PROXY_SECRET=

# Comma-separated extra hostnames the stream proxy may fetch from, beyond the hosts
# of playlists you have added. Supports leading-dot wildcards, e.g. ".example.com".
# Leave empty to allow any public host that arrives via a correctly signed URL.
ALLOWED_STREAM_HOSTS=

# Set to 1 to permit the proxy to reach private/loopback addresses. Only for local
# testing against a LAN streamer — never enable this on a public deployment.
ALLOW_PRIVATE_STREAM_HOSTS=0
